PORT=5000
MONGODB_URI=your_mongodb_connection_string
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
# JWT lifetime as a "vercel/ms" string (e.g. "15m", "24h", "7d") OR a number of SECONDS
# (e.g. "86400"). Plain numbers are interpreted as seconds, NOT milliseconds. To avoid
# ambiguity, prefer suffixed strings like "24h".
JWT_EXPIRE=24h

# Comma-separated list of allowed origins for CORS, e.g.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Leave empty in development to disallow cross-origin requests.
ALLOWED_ORIGINS=

# JSON request body size limit (express.json limit option)
BODY_LIMIT=256kb
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-actual-email@gmail.com
SMTP_PASS=your-google-app-password
FROM_EMAIL=your-actual-email@gmail.com
FROM_NAME="Optician Online Class"

# Bunny.net Stream Settings
BUNNY_VIDEO_LIBRARY_ID=your_library_id
BUNNY_API_KEY=your_access_key
BUNNY_WEBHOOK_SECRET=Secret_key
BUNNY_STREAM_TOKEN_KEY=ccess_key
BUNNY_STORAGE_ZONE_NAME=Name
BUNNY_STORAGE_ACCESS_KEY=Key
BUNNY_STORAGE_PULL_ZONE_URL=url

# PayPal Credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here